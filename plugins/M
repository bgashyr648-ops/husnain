const { cmd } = require('../command');

cmd({
    pattern: "updatestatus",
    desc: "Command ke sath diye gaye link ko sabhi groups ki description mein lagata hai",
    category: "main",
    react: "🔄",
    filename: __filename
    // Koi restriction nahi hai, har koi use kar sakta hai
},
async (conn, mek, m, { reply, text }) => {
    try {
        // Sirf Personal Chat (Inbox) mein kaam karegi, group mein nahi
        if (m.isGroup) return await reply("*Bhai, ye command sirf personal inbox mein kaam karegi, group mein nahi!*");

        // Check karna ki user ne command ke sath link diya hai ya nahi
        if (!text) return await reply("*Bhai, command ke sath group ka link bhi likhein! \nExample: .updatestatus https://chat.whatsapp.com/abcd...*");

        // Jo link user ne command ke sath diya hai, wo yahan store hoga
        const inputLink = text.trim();
        const statusText = `Official Group Link: ${inputLink}`;

        // Bot jin sabhi groups mein add hai, unka data nikalna
        const chats = await conn.groupFetchAllParticipating();
        const groups = Object.values(chats);

        if (groups.length === 0) {
            return await reply("*Bot abhi kisi bhi group mein add nahi hai!*");
        }

        // Sabhi groups ki description ek-ek karke bina kisi chat message ke update karna
        let successCount = 0;
        for (let i = 0; i < groups.length; i++) {
            const groupId = groups[i].id;
            try {
                await conn.groupUpdateDescription(groupId, statusText);
                successCount++;
            } catch (err) {
                // Agar bot admin nahi hai ya description change blocked hai, toh error log hoga aur skip karega
                console.log(`Group ${groupId} mein status update nahi ho saka:`, err);
            }
        }

        // Kaam poora hone par user ko summary dena
        return await reply(`*Kaam ho gaya! Total ${successCount} groups ka status/description naye link ke sath update kar diya gaya hai bina chat mein spam kiye!*`);

    } catch (e) {
        console.log(e);
        reply(`Error aa gaya bhai: ${e}`);
    }
});
