const { cmd } = require('../command');

cmd({
    pattern: "gcstatus",
    desc: "Lava MD: Bina admin restriction saare groups ki profile ring par link lagayein.",
    category: "owner",
    react: "🦁",
    filename: __filename
},
async (conn, mek, m, { reply, text, isCreator }) => {
    try {
        // Sirf bot owner hi chala sake
        if (!isCreator) return reply("*Lava MD Alert:* Oye bhai, ye command sirf owner chala sakta hai! ❌");
        if (!text) return reply("*Masla hai boss!* ⚠️ Jo link group status par lagana hai, wo sath mein likho.\n\n*Example:* `.gcstatus https://chat.whatsapp.com/ENB1TdIY27H...`");

        await reply("*Lava MD Action Mein!* 🐾 Bina admin restriction ke saare groups ki status ring par link lagaya ja raha hai...");

        // Saare groups fetch karna jahan aapka number add hai
        const groups = Object.keys(await conn.groupFetchAllParticipating());
        if (groups.length === 0) return reply("*Bhai, koi group nahi mila jisme aap add ho!* 🤷‍♂️");

        let successCount = 0;

        for (let gcId of groups) {
            try {
                // Yeh bina admin restriction ke seedha group ki status ring ko update karega
                await conn.sendMessage('status@broadcast', {
                    text: text
                }, {
                    backgroundColor: '#7A7E13', // Screenshot_20260703-095308_WhatsApp.jpg jaisa background color
                    font: 3,
                    statusJidList: [gcId] // Sirf is group ki story ring par target karega
                });

                successCount++;
                // 1.5 second ka delay taaki number block na ho
                await new Promise(resolve => setTimeout(resolve, 1500)); 
            } catch (err) {
                console.log(`Error on group status ring ${gcId}: `, err);
            }
        }

        return await reply(`*Kaam Done, Boss!* 🔥\n\nTotal *${successCount}* groups di profile ring te link lag gaya hai! Aap admin ho ya na ho, koi farq nahi padta aur chat de vich bhi koi message nahi gaya! 😎`);

    } catch (e) {
        console.log(e);
        reply("*Oh ho bhai, status ring par lagane mein koi error aa gaya hai!* ❌");
    }
});
